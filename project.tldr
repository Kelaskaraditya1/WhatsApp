								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "1) user creates the group and invites are send to participants users "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "2) there will 2 options Accept , Block"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "3) if Accept than add the userId in the participants List, in the chatRoom of userId add the groupId, and the user should subscribe to the topic"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "4) if block than nothing."
								}
							]
						}
