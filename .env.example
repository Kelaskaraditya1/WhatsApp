# ========================================
# Docker Configuration
# ========================================
MONGO_PORT=27017
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# For Docker (used by docker-compose)
DATABASE_URL=mongodb://admin:your_secure_password_here@mongodb:27017/whatsapp?authSource=admin

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ========================================
# Security Configuration
# ========================================
JWT_SECRET=your_jwt_secret_here_minimum_256_bits
JWT_EXPIRATION=2592000000

# ========================================
# Google OAuth Configuration
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# Twilio Configuration
# ========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=+1234567890

# ========================================
# Cloudinary Configuration
# ========================================
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# Server Configuration
# ========================================
SERVER_PORT=8080
FRONTEND_PORT=3000

# ========================================
# Frontend Configuration
# ========================================
# For Docker deployment (update with your server IP/domain)
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_OAUTH_URL=http://localhost:8080/oauth2/authorization/google
FRONTEND_CALLBACK_URL=http://localhost:3000/oauth-callback
FRONTEND_URL=http://localhost:3000

# ========================================
# Zego Cloud Configuration (Video/Audio Calls)
# ========================================
VITE_ZEGO_APP_ID=your_zego_app_id
VITE_ZEGO_SERVER_SECRET=your_zego_server_secret
